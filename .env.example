# Acta, every variable the server reads. Copy to .env and fill in what you
# need: almost all of it is optional, and an instance with none of it set
# still runs.
#
# The full reference, including the single-sign-on and importer variables left
# out here, is docs/developers/configuration.md.

# ── The basics ────────────────────────────────────────────────────────────────
ACTA_WORKSPACE=Acme
ACTA_DATA_DIR=./data
ACTA_PORT=4460
# Directory of the built SPA. Without it the server serves the API only.
ACTA_WEB_DIST=./web/dist
# Acta's own public address. Links in outbound messages, notification emails
# and Slack deliveries are built from it, so without it they are plain text.
ACTA_BASE_URL=https://acta.example.com

# ── The first administrator, seeded on first boot ─────────────────────────────
ACTA_ADMIN_EMAIL=you@example.com
ACTA_ADMIN_HANDLE=you
ACTA_ADMIN_NAME=Your Name

# ── Notification email ────────────────────────────────────────────────────────
# Acta emails people the notifications they have not opened, as one digest per
# person on their own schedule. Without a key nothing is sent and the bell is
# the whole feature, which is a supported configuration rather than a broken
# one.
#
# On Cloudflare this is a secret, not a var:
#   wrangler secret put ACTA_RESEND_API_KEY
ACTA_RESEND_API_KEY=
ACTA_EMAIL_FROM=Acta <acta@example.com>

# ── Identity provider webhooks ────────────────────────────────────────────────
# The secret your provider signs each delivery with. Unset means the endpoint
# answers 404, which is the right answer for an instance with no provider.
#
# The URL to register with the provider is your own host plus:
#   /api/v1/platform/webhook
# so for the hosted instance that is
#   https://acta.nubisco.io/api/v1/platform/webhook
#
# On Cloudflare this is a secret, not a var:
#   wrangler secret put PLATFORM_WEBHOOK_SECRET
PLATFORM_WEBHOOK_SECRET=
